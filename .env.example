# Copy to .env and fill in. .env is git-ignored; this example file is safe to commit.
# A variable already set in the shell wins over the value here.

# --- ERPNext (API user with read access to Item, Bin, Stock Ledger Entry, Purchase Order)
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# --- Administrator's emergency access key for the console and CLI (people normally sign in with their ERPNext user).
# Use a long random value, at least 24 characters, for example:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty there is no key at all (config/settings.yaml, the demo on the built-in demo ERP, then falls back to a well-known demo key that works on this machine only;
# any other settings file refuses to start with a well-known key).
ERP_AGENTS_OWNER_TOKEN=

# --- Telegram (free, buttons, no templates). The channel switches on when TELEGRAM_BOT_TOKEN is set.
# 1. In Telegram open @BotFather, send /newbot, follow the steps, copy the token it gives you (treat it like a password).
# 2. Put it below, start the app (erp-agents serve), then write /start to your new bot: it answers with YOUR chat id.
# 3. Put that number in OWNER_TELEGRAM_CHAT_ID and restart. Check with: erp-agents telegram status / telegram test
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
# polling (default, nothing public needed) or webhook (Telegram calls the tunnel; needs TELEGRAM_WEBHOOK_SECRET: letters, digits, _ and -)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp (Meta Cloud API). The channel switches on when WHATSAPP_TOKEN is set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
OWNER_WHATSAPP_NUMBER=
# Optional: approved template used outside the 24h window
WHATSAPP_TEMPLATE_NAME=
# Optional: template for purchase-order proposals (buttons: Create order / Remind me later / Reject)
WHATSAPP_PO_TEMPLATE_NAME=
# Optional: template for stock alerts (buttons: Got it / Remind me later / Details). Alerts are information only.
WHATSAPP_ALERT_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
# --- AI agents on a hosted model (optional; the default is a model on this computer, which needs no key).
# Choose the provider under Settings > AI agents, then put ONLY that provider's key here and restart. A key is never typed into the console or stored in the database.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# A key set in Windows or in your shell for another tool is used too, and wins over this file. To give this application a key of its own (its own usage on the
# provider's bill), use the ERP_AGENTS_ prefix instead: ERP_AGENTS_ANTHROPIC_API_KEY=, ERP_AGENTS_OPENAI_API_KEY=, ERP_AGENTS_GEMINI_API_KEY= (these are looked at first).
